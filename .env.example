# Copy this file to .env before starting the application:
#
#     cp .env.example .env
#
# Every variable the application reads is listed here.


# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------

# WARNING: dev sign-in. Anyone can pick an email and a role and be signed in
# as that user, with no proof of identity. Never let this reach production.
# Set to "entra" to sign in through Microsoft Entra ID instead.
AUTH_MODE=dev

# Optional shared key protecting the dev sign-in page. Empty means no key.
# Ignored when AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Signing key for session cookies. The value below is a development
# placeholder: replace it with a random secret on any deployed environment.
SESSION_SECRET=dev-only-session-secret-change-me


# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

# SQLite keeps a local clone self-contained. Deployed environments are
# expected to point this at PostgreSQL, e.g.
# postgresql+psycopg2://user:password@host:5432/mathutrice
DATABASE_URL=sqlite:///./mathutrice.db


# ------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------

# Any OpenAI-compatible endpoint. Mistral is the default; to use another
# endpoint, change LLM_BASE_URL, LLM_MODEL and LLM_API_KEY together.
LLM_BASE_URL=https://api.mistral.ai/v1

# Model served by that endpoint.
LLM_MODEL=ministral-14b-latest

# Key for that endpoint. Required: the application refuses to start without it.
# Get a Mistral key at https://console.mistral.ai (a free account works). On
# the free plan, requests may be used for training: for real data, turn that
# off in the admin panel under Privacy.
LLM_API_KEY=


# ------------------------------------------------------------------
# Microsoft Entra ID — required when AUTH_MODE=entra, unused otherwise
# ------------------------------------------------------------------

# CLIENT_ID=
# CLIENT_SECRET=
# TENANT_ID=
# REDIRECT_URL=https://example.org/auth
# POST_LOGOUT_REDIRECT_URL=https://example.org/test_login


# ------------------------------------------------------------------
# Production signals (PostHog) — off unless POSTHOG_PROJECT_TOKEN is set
# ------------------------------------------------------------------

# Set these in each deployed environment's host settings, never here: a copy
# of this file must leave PostHog off. Once the token is set, the other two
# are required and the application refuses to start without them.

# Project token from your PostHog project's settings (starts with phc_).
# POSTHOG_PROJECT_TOKEN=

# Ingestion host of your PostHog region.
# POSTHOG_HOST=

# Reported as `environment` on events and exceptions, and as
# `deployment.environment` on logs, e.g. staging or production.
# POSTHOG_ENVIRONMENT=
